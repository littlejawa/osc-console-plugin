{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "packageRules": [
    {
      "description": "Group all linter and formatter updates",
      "matchPackagePatterns": ["eslint", "stylelint", "prettier"],
      "groupName": "linters and formatters"
    },
    {
      "description": "Group PatternFly updates (they release together)",
      "matchPackagePrefixes": ["@patternfly/"],
      "groupName": "PatternFly"
    },
    {
      "description": "Group build tooling updates",
      "matchPackageNames": ["webpack", "webpack-cli", "webpack-dev-server", "css-loader", "style-loader", "swc-loader", "copy-webpack-plugin", "fork-ts-checker-webpack-plugin"],
      "groupName": "build tooling"
    },
    {
      "description": "Group type definition updates",
      "matchPackagePrefixes": ["@types/"],
      "groupName": "type definitions"
    },
    {
      "description": "Group test tooling updates",
      "matchPackagePrefixes": ["@testing-library/"],
      "groupName": "testing-library"
    },
    {
      "description": "Group Dockerfile base image updates",
      "matchManagers": ["dockerfile"],
      "groupName": "dockerfile base images"
    }
  ]
}
